<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIBoss.Pages.SessionDetailPage"
             Title="学习记录详情">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Frame>
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="TimeRangeLabel" TextColor="#666666" FontSize="12" />
                    <Label x:Name="DurationLabel" TextColor="#4361EE" FontSize="13" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="任务名称" FontAttributes="Bold" />
            <Entry x:Name="TaskTitleEntry" BackgroundColor="White" />

            <Label Text="计划产出" FontAttributes="Bold" />
            <Editor x:Name="PlannedOutputEditor" AutoSize="TextChanges"
                    MinimumHeightRequest="80" BackgroundColor="White" FontSize="14" />

            <Label Text="实际产出" FontAttributes="Bold" />
            <Editor x:Name="ActualOutputEditor" AutoSize="TextChanges"
                    MinimumHeightRequest="100" BackgroundColor="White" FontSize="14" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="保存修改" Clicked="SaveClicked" Style="{StaticResource PrimaryButton}" WidthRequest="120" />
                <Button Text="删除记录" Clicked="DeleteClicked" Style="{StaticResource DangerButton}" WidthRequest="120" />
                <Button Text="取消" Clicked="CancelClicked" Style="{StaticResource SecondaryButton}" WidthRequest="80" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
