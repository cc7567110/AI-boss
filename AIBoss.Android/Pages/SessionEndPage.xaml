<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIBoss.Pages.SessionEndPage"
             Title="记录本轮产出">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Frame>
                <VerticalStackLayout Spacing="6">
                    <Label Text="当前任务" FontAttributes="Bold" TextColor="#666666" FontSize="12" />
                    <Label x:Name="TaskTitleLabel" FontAttributes="Bold" FontSize="16" />
                    <Label Text="计划产出（来自任务目标）" FontAttributes="Bold" TextColor="#666666" FontSize="12" Margin="0,8,0,0" />
                    <Label x:Name="PlannedOutputLabel" FontSize="14" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="实际产出" FontAttributes="Bold" />
            <Editor x:Name="ActualOutputEditor" Placeholder="记录你实际完成了什么..."
                    AutoSize="TextChanges" MinimumHeightRequest="150"
                    BackgroundColor="White" FontSize="15" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="完成并记录" Clicked="FinishClicked" Style="{StaticResource PrimaryButton}" WidthRequest="140" />
                <Button Text="取消" Clicked="CancelClicked" Style="{StaticResource SecondaryButton}" WidthRequest="80" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
