<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIBoss.Pages.TaskEditPage"
             Title="编辑当前任务">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label Text="任务名称" FontAttributes="Bold" />
            <Entry x:Name="TitleEntry" Placeholder="输入任务名称" BackgroundColor="White" />

            <Label Text="任务目标" FontAttributes="Bold" />
            <Editor x:Name="GoalEditor" Placeholder="输入任务目标" AutoSize="TextChanges"
                    MinimumHeightRequest="100" BackgroundColor="White" />

            <Label Text="任务状态" FontAttributes="Bold" />
            <Picker x:Name="StatusPicker" SelectedIndex="0">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>进行中</x:String>
                        <x:String>已完成</x:String>
                        <x:String>暂缓</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Button Text="保存" Clicked="SaveClicked" Style="{StaticResource PrimaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
